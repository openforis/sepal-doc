#~ msgid ""
#~ "Loss of primary forest is mapped "
#~ "in NRT at a 10 m resolution "
#~ "using Sentinel-2 multispectral data. Cloud,"
#~ " shadow and water are detected in "
#~ "each new Sentinel-2 image and a "
#~ "forest loss algorithm is applied to "
#~ "all remaining clear land observations. "
#~ "The algorithm relies on the spectral "
#~ "data in each new image, in "
#~ "combination with spectral metrics from a"
#~ " baseline period of the previous two"
#~ " years. Confidence is built through "
#~ "repeated loss observations in the "
#~ "consequent images."
#~ msgstr ""

