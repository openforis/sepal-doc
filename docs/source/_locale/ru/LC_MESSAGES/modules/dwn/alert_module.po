#~ msgid ""
#~ "**Number of images**: Maximum number of"
#~ " images to display on the map "
#~ "(defaults to six)."
#~ msgstr ""

#~ msgid ""
#~ "**Day before**: Number of the previous"
#~ " day that the interface can search"
