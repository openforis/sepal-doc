#~ msgid "Export as .gpkg"
#~ msgstr ""

#~ msgid ""
#~ "Export alerts as a :code:`.gpkg` file,"
#~ " readable by any GIS software. It "
#~ "will embed the geometry and all "
#~ "properties associated with each feature/alert"
#~ " (including the original geometry). This"
#~ " file can be used to save "
#~ "progress and reused as an input of"
#~ " the process."
#~ msgstr ""

#~ msgid "Export as .csv"
